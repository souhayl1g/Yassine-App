# Environment Variables for Vercel Deployment

# IMPORTANT: Add this in Vercel Dashboard → Settings → Environment Variables
# This is used by the serverless function /api/[...path].ts to proxy requests to your backend

# Backend API URL (REQUIRED for production)
# DO NOT include /api at the end - just the base URL
# Examples:
#   - ngrok: https://abc123.ngrok-free.app
#   - Railway: https://your-backend.railway.app  
#   - Render: https://your-backend.onrender.com
#   - Public IP: http://your-ip:3000
BACKEND_BASE_URL=http://localhost:3000

# Instructions:
# 1. In Vercel Dashboard, go to Settings → Environment Variables
# 2. Add: BACKEND_BASE_URL with your actual backend URL (without /api)
# 3. IMPORTANT: Redeploy after adding the variable!
#    Go to Deployments → Click ... → Redeploy
