# Environment Variables for Vercel Deployment

# Backend API URL (REQUIRED for production)
# Example: https://your-backend.railway.app
# Example: https://abc123.ngrok-free.app
BACKEND_BASE_URL=https://preneuralgic-overexuberantly-marjorie.ngrok-free.dev

# Node Environment
NODE_ENV=production

# Instructions:
# 1. Copy this file to create your local .env file (don't commit .env)
# 2. Add these variables to Vercel Dashboard → Settings → Environment Variables
# 3. Update BACKEND_BASE_URL with your actual backend URL
