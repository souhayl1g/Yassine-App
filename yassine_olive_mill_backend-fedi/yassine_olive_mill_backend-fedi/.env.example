# Backend Environment Configuration Template

# Server Configuration
PORT=3000
HOST=0.0.0.0

# CORS - Update with your actual Vercel URL after deployment
ALLOWED_VERCEL_ORIGINS=https://your-app.vercel.app,https://your-app-*.vercel.app
CORS_EXTRA_ORIGINS=http://192.168.1.19:3000,http://localhost:5173,https://localhost:5173

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/olive_mill
# Or individual settings:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=yassine-app
DB_USER=your_db_user
DB_PASSWORD=97972002

# JWT Configuration
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_EXPIRES_IN=24h

# Node Environment
NODE_ENV=development

# Optional: Logging
LOG_LEVEL=info

# Optional: Session Configuration
SESSION_SECRET=your_session_secret_here
